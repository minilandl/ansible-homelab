// {{ ansible_managed }}
// Managed by the auto_patching Ansible role. Do not edit by hand.

{% set dist = ansible_facts['distribution'] | default('Debian') %}
{% set sec_origins = patch_security_origins[dist] | default(patch_security_origins['Debian']) %}
{% set extra_origins = (patch_extra_origins[dist] | default([])) if patch_update_scope == 'all' else [] %}
Unattended-Upgrade::Origins-Pattern {
{% for origin in sec_origins %}
    "{{ origin }}";
{% endfor %}
{% for origin in extra_origins %}
    "{{ origin }}";
{% endfor %}
{% for origin in patch_extra_allowed_origins %}
    "{{ origin }}";
{% endfor %}
};

Unattended-Upgrade::Package-Blacklist {
{% for pkg in patch_blacklist_packages %}
    "{{ pkg }}";
{% endfor %}
};

Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::InstallOnShutdown "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "{{ patch_remove_unused_kernels | bool | lower }}";
Unattended-Upgrade::Remove-New-Unused-Dependencies "{{ patch_remove_unused_dependencies | bool | lower }}";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ patch_remove_unused_dependencies | bool | lower }}";

Unattended-Upgrade::Automatic-Reboot "{{ patch_auto_reboot | bool | lower }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ patch_auto_reboot_time }}";

{% if patch_notify_email | length > 0 %}
Unattended-Upgrade::Mail "{{ patch_notify_email }}";
Unattended-Upgrade::MailReport "{{ 'only-on-error' if patch_email_only_on_error else 'on-change' }}";
{% endif %}
