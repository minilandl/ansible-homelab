lang: "en-us"
checkrr:
  checkpath: 
    - "data/movies/"
    - "data/tvshows/"
    - "data/anime/"
  database: ./checkrr.db
  debug: true
  csvfile: "./badfiles.csv"
  cron: "@daily"
  ignorehidden: true
  requireaudio: true
  ffmpeg-full: false
  ffmpeg-quick: false
  ffmpeg-quick-seconds: 120
  ffprobe: true
  ignorepaths:
    - '/tv/ignored'
  ignoreexts:
    - .(null)
    - .txt
    - .trickplay
    - .nfo
    - .nzb
    - .url
    - .jpg
    - .srt
    - .pdf
    - .nfo-orig
    - .url
    - .svg
logs:
  stdout:
    out: stdout
    formatter: default
  file:
    out: file
    path: "/var/log/checkrr.log"
    formatter: default
arr:
  radarr:
    process: true
    service: radarr # should be one of: sonarr radarr lidarr
    address: "radarr.jaspergreenhill.com"
    apikey: "478f0bae5cec4704850bff43b310e220"
    baseurl: /
    port: 443
    ssl: true
    mappings: # maps directories between docker and arr services
      "/data/movies/": "/data/movies/" # what radarr sees: what checkrr sees
  sonarr:
    process: true
    service: sonarr
    address: "sonarr.jaspergreenhill.com"
    apikey: "e784307994374a06bfa2077f39c1cd9a"
    baseurl: /sonarr
    port: 443
    ssl: false
    mappings:
      "/data/movies": "/data/tvshows"
      "/data/anime": "/data/anime"
notifications:
  discord:
    url: "https://discordapp.com/api/webhooks/1551927682340618322/MlKIRKZQ99utwCAKoap2Ml2eo73KMIPFNiZWwsPZud_dXcEbWotyQyh8vbFXqJFp4HHH"
    notificationtypes: 
      - reacquire
      - unknowndetected
      - startrun
      - endrun
webserver:
  port: 8585
  tls: false
  baseurl: "/"
  trustedproxies:
    - 127.0.0.1
